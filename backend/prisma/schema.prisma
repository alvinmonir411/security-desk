datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SECURITY_GUARD
  SUPERVISOR
  MANAGER
  AGM
  DGM
  ADMIN
}

enum GuardStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  RESERVE
}

enum RosterStatus {
  DRAFT
  GENERATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  LOCKED
}

enum AssignmentStatus {
  SCHEDULED
  CONFIRMED
  REPLACED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  WEEKLY_OFF
  REPLACED
}

enum LeaveStatus {
  PENDING
  SUPERVISOR_REVIEWED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         RoleType  @default(SECURITY_GUARD)
  managerId    String?
  supervisorId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  manager      User?     @relation("ManagerSupervisors", fields: [managerId], references: [id])
  supervisors  User[]    @relation("ManagerSupervisors")
  supervisor   User?     @relation("SupervisorGuards", fields: [supervisorId], references: [id])
  guards       User[]    @relation("SupervisorGuards")

  guardProfile SecurityGuard?
  auditLogs    AuditLog[]

  @@index([role])
}

model SecurityGuard {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber       String        @unique
  bloodGroup        String?
  joiningDate       DateTime
  status            GuardStatus   @default(ACTIVE)
  defaultLocationId String?
  accumulatedDutyHours Float      @default(0)

  assignments       RosterAssignment[]
  attendanceLogs    Attendance[]
  leaveRequests     LeaveRequest[]
  replacements      ReplacementRequest[] @relation("ReplacedGuard")
  standbyReplacements ReplacementRequest[] @relation("StandbyGuard")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([badgeNumber])
}

model Location {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  type        String   // Factory, Warehouse, Depot, Corporate, Residence
  address     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts        LocationPost[]
  requirements LocationRequirement[]
  assignments  RosterAssignment[]
  attendance   Attendance[]

  @@index([isActive])
}

model LocationPost {
  id          String   @id @default(uuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Main Gate", "Perimeter North"
  code        String
  createdAt   DateTime @default(now())

  assignments RosterAssignment[]
  @@unique([locationId, code])
}

model Shift {
  id              String   @id @default(uuid())
  name            String   // DAY, NIGHT
  code            String   @unique
  startTime       String   // "06:00" or "08:00"
  endTime         String   // "18:00" or "20:00"
  durationHours   Float    @default(12)
  crossesMidnight Boolean  @default(false)
  isActive        Boolean  @default(true)

  requirements    LocationRequirement[]
  assignments     RosterAssignment[]
  attendance      Attendance[]
}

model LocationRequirement {
  id             String   @id @default(uuid())
  date           DateTime @db.Date
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift    @relation(fields: [shiftId], references: [id])
  requiredGuards Int      @default(1)
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, locationId, shiftId])
  @@index([date, locationId])
}

model Roster {
  id              String       @id @default(uuid())
  date            DateTime     @unique @db.Date
  status          RosterStatus @default(DRAFT)
  totalRequired   Int          @default(0)
  totalAssigned   Int          @default(0)
  totalShortage   Int          @default(0)
  publishedAt     DateTime?
  publishedById   String?
  lockedAt        DateTime?
  notes           String?

  assignments     RosterAssignment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([date, status])
}

model RosterAssignment {
  id             String           @id @default(uuid())
  rosterId       String
  roster         Roster           @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  guardId        String
  guard          SecurityGuard    @relation(fields: [guardId], references: [id])
  locationId     String
  location       Location         @relation(fields: [locationId], references: [id])
  postId         String?
  post           LocationPost?    @relation(fields: [postId], references: [id])
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id])
  date           DateTime         @db.Date
  status         AssignmentStatus @default(SCHEDULED)
  isOverride     Boolean          @default(false)
  overrideReason String?

  attendance     Attendance?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([guardId, date]) // Enforces maximum 1 shift assignment per guard per date
  @@index([rosterId, locationId, shiftId])
  @@index([date, guardId])
}

model Attendance {
  id             String           @id @default(uuid())
  guardId        String
  guard          SecurityGuard    @relation(fields: [guardId], references: [id])
  assignmentId   String?          @unique
  assignment     RosterAssignment? @relation(fields: [assignmentId], references: [id])
  locationId     String
  location       Location         @relation(fields: [locationId], references: [id])
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id])
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  verifiedById   String?
  remarks        String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([date, locationId, shiftId])
}

model LeaveRequest {
  id             String      @id @default(uuid())
  guardId        String
  guard          SecurityGuard @relation(fields: [guardId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  approvalNotes  String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([guardId, startDate, endDate])
}

model ReplacementRequest {
  id              String      @id @default(uuid())
  date            DateTime    @db.Date
  originalGuardId String
  originalGuard   SecurityGuard @relation("ReplacedGuard", fields: [originalGuardId], references: [id])
  standbyGuardId  String
  standbyGuard    SecurityGuard @relation("StandbyGuard", fields: [standbyGuardId], references: [id])
  locationId      String
  shiftId         String
  reason          String
  requestedById   String
  approvedById    String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([date, locationId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // ROSTER_GENERATE, OVERRIDE_OFF_DAY, REASSIGN_GUARD, MARK_ABSENT
  entity     String   // Roster, RosterAssignment, Attendance
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([entity, entityId])
  @@index([timestamp])
}
